{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@ui/*": ["./apps/ui/*"],
      "@api/*": ["./apps/api/*"]
    }
  },
  "include": ["playwright.config.ts", "apps/**/*.ts"]
}
